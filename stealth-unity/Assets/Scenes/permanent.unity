MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1313177928}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4e28cf209d70868ca7dec5678534e8e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    name: "Jose Ram\xF3n, el mago le\xF3n"
    sentences:
    - "Gracias por traerme la nota. Espero que se me pase pronto el dolor de cabeza.
      De momento no te preocupes por nada m\xE1s, es suficiente."
    - "Aunque bueno, pens\xE1ndolo bien, creo que podr\xE1s necesitar un mapa, podr\xE1
      serte \xFAtil."
    - "Si no recuerdo mal, hay uno en los cofres que est\xE1n al lado de donde has
      recogido la nota. Cuando tengas el mapa, ven a verme."
