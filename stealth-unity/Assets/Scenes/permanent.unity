  m_Script: {fileID: 11500000, guid: 008b4c263f624cf4c938838b61590e99, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  amount: 1
  c_sound: {fileID: 8300000, guid: 0998a21ecbd624148ad427a4249ece1a, type: 3}
  item_name: Headache's potion prescription
  item_description: Jose the Magician needs it for making a potion for it's headache.
    Deliver it to him.
  message: "C\u0338\u0341\u030F\u030E\u0304\u0307\u0340\u0314\u0304\u034A\u0344\u033B\u035A\u0332\u0359\u0348\u0339o\u0337\u0303\u0315\u030F\u0360\u0358\u034C\u030A\u0325m\u0336\u0313\u035D\u0308\u0311\u0305\u0343\u0358\u033D\u030D\u0350\u0340\u0315\u0306\u030A\u0350\u0330\u032F\u0319\u032D\u0320\u031E\u031Fp\u0337\u0357\u0310\u030B\u0360\u0304\u0360\u030B\u0322\u032C\u032D\u0317\u0325\u0319o\u0337\u034C\u030C\u0310\u0309\u0314\u030B\u0315\u0309\u0344\u0304\u0314\u0346\u0349\u032C\u0322\u031D\u032C\u0320\u0329\u032F\u035C\u032As\u0338\u030C\u034B\u0313\u0343\u0318\u0319\u0322\u0339\u0326\u032C\u033A\u0356\u0321\u0330\u0359\u0324i\u0334\u0350\u0306\u033D\u0358\u0350\u035D\u030F\u0305\u034A\u0351\u0341\u030E\u0306\u0352\u031B\u0321\u032D\u0319\u032C\u033B\u0331\u0326\u0328\u0328\u0353\u0345\u031C\u032F\u033B\u0318c\u0337\u0357\u0344\u0306\u035D\u0310\u0315\u032B\u0353\u0320\u032D\u0326\u0329\u034D\u0317\u032E\u0359\u0321i\u0334\u0308\u030D\u0342\u0304\u0314\u0304\u0303\u034D\u033B\u0333\u0353\u0326\u0345\u0321\u0323\u033C\u0329\u0347\u0320\xF3\u0337\u031A\u0340\u0350\u035D\u0346\u030A\u0305\u031B\u0300\u0314\u035B\u0360\u0323\u031F\u032A\u031D\u032A\u0326\u0331\u035C\u0316\u034D\u0316\u032C\u034E\u0355n\u0338\u0343\u035B\u033D\u0358\u030C\u0311\u0351\u034A\u0306\u034A\u033F\u0350\u033D\u0309\u0315\u031F\u032E\u032B\u034E\u031E\u0317\u0355\u032E\u0348\u032D\u035A\u031E\u032E\u0325
    \u0336\u0302\u0340\u035D\u034B\u0344\u0308\u0315\u030B\u0315\u0350\u0302\u0342\u031B\u0350\u0300\u0348\u0333d\u0338\u033F\u0311\u0310\u033F\u0342\u031B\u0341\u0311\u0311\u0340\u0340\u0341\u0341\u033B\u0348\u0327\u032C\u0324\u0331\u0356\u0356\u033Be\u0335\u0343\u0309\u031B\u030E\u0352\u035A\u0339\u032A\u032C\u0331\u0321\u0323\u0326\u0330\u0322\u0339\u031E\u031E\u0317\u0320
    \u0334\u0300\u0309\u0342\u0314\u035D\u031B\u031A\u0315\u0342\u0358\u034A\u034B\u0357\u030F\u030B\u0354\u0317\u0316\u031C\u0348\u0325\u031CP\u0334\u030B\u032A\u032F\u0347\u0332\u0329\u0316\u0354\u033B\u0345\u0324\u0331\u0316\u0345\u0355\u0355a\u0335\u0315\u0346\u035B\u0314\u0343\u0313\u0352\u0346\u0350\u0340\u0307\u030A\u0320\u031F\u0328\u035A\u0354\u032A\u033Br\u0336\u031B\u0342\u0341\u0357\u0342\u0317\u032F\u0332\u033C\u0332\u035Aa\u0338\u0357\u0300\u0300\u0350\u0357\u0310\u0321\u0331\u0345\u032Bc\u0335\u035D\u0358\u0305\u0360\u033D\u0342\u0333\u034D\u0353\u0356\u0328\u0329\u0333\u0320\u0354\u0324\u0316\u0327e\u0338\u0306\u034A\u0310\u0314\u030C\u031Ft\u0334\u035B\u033D\u0342\u0303\u0350\u0300\u0302\u0311\u031A\u035B\u035B\u0342\u032C\u032C\u0348\u031D\u0317a\u0338\u0309\u0310\u030F\u031B\u0352\u030F\u034D\u0316\u0322\u033C\u0353\u033B\u035A\u031F\u0354\u032B\u0339\u0322\u031D\u0359\u0349m\u0334\u030B\u031E\u0354\u0320\u031C\u0319\u031E\u031F\u0322\u0321\u034E\u0321\u0323o\u0334\u0303\u035D\u0312\u0344\u0309\u034C\u030E\u030E\u030A\u035B\u0307\u0325\u031F\u0347\u033A\u035A\u033Cl\u0337\u0341\u030D\u031A\u030D\u031A\u0307\u0307\u033F\u0330\u0354\u0317\u0328\u0328\u0326
    \u0337\u0308\u0352\u0300\u030C\u0343\u0342\u0341\u033D\u0358\u0301\u034C\u031F\u032C\u0356\u0359\u0318\u0321\u0348\u0316\u031E\u032CN\u0334\u0306\u0360\u031B\u033E\u0357\u0312\u031F\u033Co\u0336\u0306\u034A\u035D\u0343\u0315\u035D\u031A\u033F\u034A\u0309\u031A\u034E\u0316\u031D\u031F\u0327\u035A\u0329\u0348\u0316r\u0334\u0311\u035D\u0302\u0351\u0333\u0353\u0348\u0324\u035A\u0319\u035C\u031Cm\u0334\u035D\u034B\u0310\u0351\u0300\u0309\u030C\u033F\u0357\u0350\u0307\u030D\u0322\u0320\u0339\u0328\u033B\u031C\u0327\u0354\u032D\u0347\u031C\u031F\u0331o\u0337\u034C\u0357\u031B\u0341\u031A\u0344\u0300\u0304\u030A\u032D\u034E\u032E\u033B\u035C\u0348\u035C\u0354\u032C\u0330\u032F\u033B\u0319n\u0336\u030B\u0308\u035D\u032B\u0324\u0330\u0331\u035C\u032D\u0339\u0329\u031E\u0328\u031D\u0320
    \u0335\u030D\u033F\u0312\u0352\u0315\u0341\u0329\u0331\u0347\u0319\u0325\u032C\u0348\u0322\u0331\u0318\u0327\u032E5\u0334\u0358\u0313\u0312\u0302\u0358\u0300\u0309\u0300\u0340\u0302\u0352\u0344\u034A\u0344\u032F\u0321\u031D\u032A\u035A\u0355\u033A\u0331\u03390\u0337\u0306\u031A\u034B\u034A\u030C\u033F\u030E\u0351\u0344\u0311\u0323\u033B\u032D\u0328\u034D\u0332\u0356\u0317\u035A\u0326\u031C\u03170\u0337\u0305\u0300\u033D\u035B\u0357\u0300\u0309\u035D\u034B\u0346\u031A\u0353\u0319\u0317
    \u0338\u0302\u033E\u030B\u0304\u0318\u0333\u0322\u031F\u0353\u032B\u0349\u0348\u0330\u0318m\u0338\u035D\u0344\u0360\u030F\u0352\u035B\u0305\u0350\u0306\u030F\u0347\u0319\u0316\u0317g\u0337\u0302\u030C\u0310\u0351\u0352\u0315\u0304\u0306\u034C\u0300\u033F\u0304\u0341\u0358\u0353\u031C\u032F\u0330\u0330\u0317\u032B\u0317\u0319\u031F\u0356
    \u0334\u0311\u0351\u0311\u0340\u0340\u030B\u0307\u0305\u0311\u030C\u031F\u0330\u0347\u0316\u0356
    \u0336\u0346\u0309\u0344\u0309\u035D\u0302\u030A\u0306\u0351\u0307\u034A\u0300\u0300\u034D\u034E\u0325\u032C\u0347\u0345\u0316\u031E\u031E\u031FE\u0338\u0350\u0312\u0305\u0340\u0311\u033D\u0308\u030B\u0344\u0341\u0341\u031B\u0314\u035D\u030A\u0353\u0321\u033B\u0321\u0316\u0321\u032F\u031C\u031E\u035C\u0331\u0345\u033C\u0324l\u0334\u0343\u030A\u0344\u031A\u0346\u030D\u0303\u0309\u031E\u0333
    \u0337\u0305\u033E\u0314\u033E\u0325\u0326\u0333\u0320\u0325\u032B\u033A\u032E\u0332\u0348\u032D\u032A\u035A\u032Ap\u0337\u0360\u0312\u0351\u035D\u0329\u0325r\u0334\u0309\u0355\u0345\u0325\u033A\u0347\u0320\u0332\u032A\u031E\u035C\u033B\u031E\u033A\u0321\u0349i\u0336\u0308\u0350\u0349\u035C\u0318\u0322\u033A\u0320\u034E\u0323\u032F\u0345\u0333\u0322\u0320n\u0338\u0312\u0304\u0308\u030B\u0350\u0312\u035D\u0341\u0344\u0315\u031C\u035A\u031D\u0328c\u0334\u0313\u030C\u0308\u0314\u030F\u0307\u0306\u0314\u0307\u030F\u035D\u030D\u0354\u032C\u0329\u0339\u032Ai\u0335\u0308\u0308\u0343\u0308\u0302\u032B\u0355\u0316\u032F\u0333\u0356\u0320\u0333\u032F\u032C\u035A\u0339\u035Ap\u0337\u0312\u0358\u0357\u033F\u0360\u0312\u0346\u0354\u0356i\u0338\u0312\u030C\u033D\u034B\u033F\u0343\u0342\u0306\u0342\u033F\u0324\u0331\u0355\u0339\u0323\u031E\u0320\u035A\u0328o\u0338\u0306\u032C\u0348\u032A\u031C\u0328\u0323\u032E\u032B
    \u0334\u0352\u0308\u0307\u0314\u0309\u0306\u0307\u031B\u033D\u0349\u0318\u0329\u0331\u0323\u0345\u031E\u0328\u0333\u032E\u0356\u032F\u031D\u0320a\u0335\u030F\u034A\u0344\u030A\u0343\u030E\u034B\u0340\u0307\u034C\u0315\u0303\u033E\u030A\u033A\u0320\u0353\u0359\u0322c\u0336\u0304\u030C\u033A\u032A\u032F\u0321\u0348\u0332\u032C\u0318\u0359\u0354\u0331\u0320\u0356\u0353\u0345t\u0334\u0310\u0305\u0327\u0354\u032D\u0324\u0347i\u0336\u0351\u0313\u0315\u033E\u0357\u030C\u0343\u0305\u0342\u030B\u0307\u031B\u0329\u0359\u0355v\u0335\u030B\u0311\u034C\u0311\u034B\u035B\u034B\u0308\u030B\u033D\u0306\u0340\u0358\u0325\u031D\u0326\u031C\u0331\u034E\u032Ao\u0334\u033F\u0340\u0341\u0352\u0346\u0302\u0307\u0308\u0303\u033A\u0319
    \u0337\u035B\u031B\u0340\u0352\u0304\u030C\u0351\u0350\u0314\u0358\u0344\u0315\u0340\u0309\u0342\u0349\u031C\u0347\u034D\u032F\u035Ae\u0337\u034B\u0344\u0305\u0301\u0341\u0351\u0315\u0300\u0302\u035B\u0357\u0344\u0342\u031D\u0347\u031D\u0332\u031F\u0356\u032A\u032D\u0320\u032A\u0347\u0328\u0347s\u0338\u031A\u0303\u0302\u033E\u0352\u033E\u0311\u0349\u033B\u0318\u035C
    \u0336\u035B\u0343\u0315\u033F\u0350\u030F\u0344\u0352\u0311\u035D\u0300\u0344\u0341\u030F\u0301\u0318\u0356\u0349\u0348\u0318\u035C\u035Ap\u0335\u0310\u0309\u0301\u031A\u0303\u030E\u0343\u0344\u0312\u0313\u031A\u0302\u0318\u0322\u0327\u0329\u0329\u0323\u0329\u0328\u035C\u032C\u0354a\u0336\u0357\u0308\u030C\u0309\u0344\u033E\u0309\u030E\u030F\u033F\u030E\u035B\u031B\u0314\u0310\u0322\u0330\u0353\u033A\u0329\u0322\u032F\u035C\u0353\u0316\u0328\u0325\u033A\u034E\u0331r\u0334\u0351\u0305\u0353\u0356\u0348\u0318\u0331\u0332\u034D\u035A\u0348\u0325\u031E\u0330\u0323\u0323a\u0338\u0352\u034C\u0340\u033D\u0344\u0357\u0332\u0333\u034E\u0345\u0316\u0353\u0331\u034D\u0323\u0359\u0320c\u0334\u031A\u035B\u035D\u034B\u0312\u0360\u0348\u0348e\u0335\u0303\u0304\u0306\u031A\u0312\u0346\u030E\u033D\u033F\u0359\u032E\u0345\u0339\u0316\u031F\u0354t\u0335\u030A\u0356\u032A\u0323\u0347\u034E\u032C\u0347\u0329a\u0337\u0341\u0310\u030C\u030E\u0314\u0326\u0333\u0320\u035C\u0332\u0325\u033A\u0348\u0326\u0345\u0320\u0339\u032Am\u0337\u0303\u0309\u035D\u030B\u0307\u031B\u030F\u0344\u0303\u030C\u0306\u0306\u034A\u034A\u0318\u032D\u033C\u032E\u0327\u0316o\u0336\u0303\u0341\u0313\u030C\u0342\u0308\u0360\u0301\u030E\u0311\u034C\u0306\u035D\u0346\u034A\u031E\u0359\u0333\u0328\u035A\u032D\u0318\u0321\u0356\u0331\u0322\u0323l\u0338\u0340\u0300\u0312\u0340\u0309\u031B\u033E\u0357\u0301\u0306\u0303\u030E\u0314\u0354\u0327\u033C\u0325\u0325\u0327\u0359\u0316\u0322\u033A\u0339\u0354.\u0337\u0309\u0358\u0352\u0315\u0311\u033E\u035B\u030D\u0344\u032A\u032B\u0322\u0347\u0329\u035C\u032B\u033A
    \u0335\u0315\u035B\u0346\u0310\u0345\u0331\u034D\u0320\u032F\u033BC\u0336\u0360\u0340\u0313\u0331\u033C\u0345\u0339\u035C\u0323a\u0335\u0343\u0314\u0324\u0323\u0356\u034D\u035A\u031E\u0316\u031F\u032A\u0322\u0331\u0320d\u0335\u030B\u0307\u0312\u031A\u030E\u0315\u0303\u0310\u0344\u0301\u0314\u030E\u0313\u034D\u0353\u035C\u0345\u0328\u0332\u0333\u0359\u0353a\u0334\u0305\u0313\u0346\u0307\u035B\u0308\u034B\u0343\u0327\u0345\u0318\u0333\u0322\u0329\u0330\u0317\u0321\u0325\u035A\u0354\u031D\u0326\u031C
    \u0335\u0302\u0310\u030A\u030C\u0307\u0307\u0360\u033C\u0320\u035C\u0318\u0359\u035C\u0321\u031D\u034E\u0319c\u0338\u0303\u0343\u0313\u0307\u035D\u0307\u0357\u0360\u0300\u0322\u031D\u034E\u0349\u0322\u033A\u0353\u0325\u0333\u032D\u0330\u035Ao\u0336\u030A\u035D\u033E\u030F\u0313\u031B\u0314\u035D\u0350\u0357\u0349\u0345\u032F\u0339\u032E\u0319\u0316m\u0334\u0302\u034A\u0306\u030B\u0351\u0344\u031F\u032Ep\u0334\u0344\u0302\u0312\u0313\u0354\u032C\u0353\u035A\u0325\u0354\u0326\u032A\u032F\u0320\u031D\u035A\u031C\u0355\u032Fr\u0334\u0352\u0358\u033E\u0311\u030F\u0341\u0315\u0358\u030B\u0350\u0313\u0352\u0344\u030B\u0304\u033A\u0345\u0321\u0329\u0326\u035A\u033Ci\u0336\u0301\u0311\u0301\u0342\u0358\u030D\u033D\u0300\u0351\u030E\u0344\u032E\u0317\u0330\u032A\u0318\u0359m\u0335\u0308\u0309\u032B\u031Fi\u0338\u035D\u031B\u030A\u0340\u0340\u0301\u034A\u030D\u0358\u0317\u0323\u0345\u033A\u0348\u0359d\u0337\u0309\u0301\u0344\u034C\u0303\u0306\u030B\u0307\u032F\u0327\u0324o\u0338\u0358\u0304\u034D\u0327\u031F\u0325\u0353\u0323\u0332\u031D\u0329\u0324\u0345
    \u0337\u0308\u034C\u0312\u0351\u0344\u035D\u031E\u0319\u0319\u034E\u0347\u0356\u0332\u032F\u0345\u0355\u0359\u0356\u0333\u0330\u0328c\u0334\u0312\u031B\u035D\u033D\u0352\u0306\u0360\u0341\u031D\u0328\u0329\u0320\u0356\u0345\u0348\u034D\u0345\u0325\u0321\u032F\u035A\u0355o\u0334\u0352\u0343\u035D\u0342\u0341\u035D\u0304\u030E\u033D\u034C\u0342\u030B\u0321\u0318\u033C\u032D\u0316\u0331\u031D\u0326\u0339\u0325n\u0337\u0340\u0344\u0310\u0312\u0302\u0354\u035C\u032Dt\u0334\u0311\u0342\u0358\u033E\u033F\u0303\u0342\u032F\u032E\u0323\u032A\u0356\u0347i\u0338\u035B\u030A\u030F\u0352\u034B\u035D\u0310\u0300\u034C\u0340\u0333\u0348\u032D\u032A\u0356\u0326\u0325\u035A\u034D\u0339\u032B\u031C\u0328\u0354\u0348e\u0337\u0357\u030A\u030E\u0302\u0306\u0340\u0301\u0342\u030B\u035D\u035D\u0360\u0351\u0341\u0312\u0320\u0333\u032D\u033C\u0356n\u0338\u0313\u0350\u030C\u035D\u035B\u0321\u0339\u0355\u033B\u033C\u0325e\u0334\u0300\u0346\u0312\u030B\u030F\u030C\u033E\u0340\u034C\u0360\u0311\u0302\u032B\u0353\u0354\u0348\u0347\u0316\u0332\u033A\u032F\u032B\u034D\u0317\u033C\u033B\u0359
    \u0336\u030F\u0352\u033D\u034C\u0350\u0310\u0308\u0350\u0306\u0340\u033D\u0351\u030A\u033C\u034E\u0325\u034E\u0323\u0345\u0345\u0332\u03315\u0337\u030C\u0314\u0308\u032C\u03260\u0337\u0350\u034A\u033A0\u0335\u0344\u0308\u034B\u034C\u0346\u034A\u034B\u034D\u0322\u0359\u0318\u031C\u034E\u0323\u0331\u0329\u0327\u0318\u031F\u0348\u032E\u032B
    \u0337\u035D\u0351\u0301\u033F\u0357\u0310\u0358\u034A\u0307\u031B\u031B\u030F\u0304\u030C\u031B\u034D\u0331\u0354\u031D\u0326\u0356\u032B\u031D\u0347\u0330\u034E\u0327m\u0337\u0312\u0328\u0349\u031D\u031F\u0323\u0353\u0326\u0332\u0326\u0345\u0349\u0323\u0353g\u0338\u0346\u0360\u0304\u032E\u0356\u031E\u0318\u0333\u0332\u0320\u0320\u0324\u0316\u0331\u0323\u0325\u0318
    \u0335\u031B\u0314\u0360\u035B\u032A\u034D\u033B\u032B\u0330\u032D\u0356\u031Dd\u0335\u0305\u0326\u0347\u0349\u033A\u0348\u032A\u0330\u031D\u0321\u0355\u032Fe\u0335\u0305\u0304\u0352\u030D\u0358\u0300\u0360\u0351\u0313\u0309\u0344\u0329\u034E\u031D\u0331\u031F\u031D\u031F\u0328\u0319\u032B\u0319\u0348
    \u0337\u0360\u0342\u034C\u0342\u0300\u033D\u031B\u0324\u0354\u0325\u0323\u031D\u032E\u0347\u035Cp\u0337\u0312\u0309\u035B\u0325\u033B\u031F\u0326a\u0335\u030B\u0312\u0358\u030C\u030D\u0341\u0300\u0313\u0302\u034B\u0311\u0302\u0359\u0353\u0330\u0325\u033B\u0359\u0347\u0348r\u0335\u0344\u0310\u0344\u030F\u035D\u035B\u0308\u0357\u0357\u0348\u0318\u0324\u0353\u0356\u0359\u032B\u0329\u031D\u0348\u0326a\u0337\u034C\u031B\u0307\u034A\u0314\u033D\u0314\u030A\u030E\u0344\u0346\u032C\u0356\u0353\u0326c\u0338\u030C\u033D\u0340\u0312\u035D\u035A\u0353\u0317\u0320e\u0336\u0312\u034B\u030A\u034C\u030F\u034B\u0346\u0301\u0352\u034A\u0344\u0306\u032D\u032D\u034Dt\u0336\u0307\u0310\u0304\u031B\u0351\u0300\u033D\u0345\u0321\u0356\u033C\u0322\u0326a\u0334\u035B\u035D\u030D\u0312\u034B\u0346\u0340\u0313\u0313\u0312\u0333\u031F\u0353\u035Am\u0337\u0341\u0305\u030D\u0308\u0300\u0360\u0312\u0326\u0353\u0319\u0347\u033C\u0349\u0329\u032Ao\u0336\u030F\u030F\u0360\u0315\u0303\u0347\u033A\u0327\u0319\u0319\u035A\u0322\u0326l\u0335\u0342\u0340\u030E\u0304\u0300\u0303\u0346\u034B\u0358\u0350\u0305\u0346\u0359\u0322\u0353\u0318\u0332\u032C.\u0335\u0308\u0350\u0354\u032E\u032E\u0326\u0331\u0319\u031C\u0318\u0322\u0327\u031C\u0324\u033C\u0322
    \u0338\u030C\u0352\u030C\u0360\u031A\u0301\u0344\u0302\u0343\u0317\u032D\u032A
    \u0338\u0304\u0313\u034B\u030B\u035D\u033F\u0310\u030B\u033F\u030C\u031F\u0317\u0355\u0318\u0324\u0349\u031F\u0329\u034D\u0328\u033BL\u0334\u0302\u0320\u0330\u0353\u0347\u0332\u0332\u0348\u0355\u0324\u0356\u031Do\u0335\u0352\u035C\u0355\u0355\u0356\u0354\u032D\u0359\u032D\u032D\u031C\u0328\u0333s\u0334\u0310\u0304\u0351\u0350\u0306\u035D\u035B\u034A\u0311\u0357\u0318\u033B\u032C\u0328\u033C
    \u0336\u034C\u0357\u033D\u0358\u0358\u0310\u0341\u035D\u0314\u0340\u0302\u0343\u0343\u0330\u031D\u0354\u0323\u035C\u033C\u035A\u0353\u0348\u0355\u033C\u0354\u031C\u0345\u0322d\u0335\u0312\u0341\u0343\u0341\u0310\u030B\u0341\u0360\u033E\u030A\u030A\u030E\u0304\u0342\u030A\u0354\u0331\u0329\u032F\u034E\u034E\u0347\u032A\u031C\u032D\u0339\u0345e\u0336\u0309\u032B\u0347\u031C\u035Cm\u0337\u0350\u0346\u0346\u0358\u0309\u0300\u035D\u035D\u030E\u033D\u0360\u033A\u0356\u0348\u033B\xE1\u0334\u031A\u035B\u0305\u0360\u030B\u0355\u035A\u0318\u032As\u0337\u030D\u0341\u033E\u0307\u0352\u0307\u0303\u032B\u0333\u0320\u033A\u0353\u0331\u033C\u0345\u033C\u0318\u0323
